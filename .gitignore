# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging
dist/
build/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checker and linter caches
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter and local runtime artifacts
.ipynb_checkpoints/
.tmp/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/settings.json


# Logs and test outputs
*.log
*.txt
test_reports/*
!test_reports/README.md
# Independent review artifacts:
# - Track current lane-operational snapshots in independent_reviews/latest
# - Keep high-churn historical archives under independent_reviews/history ignored
independent_reviews/**
!independent_reviews/README.md
!independent_reviews/latest/
!independent_reviews/latest/*_latest.md
!independent_reviews/latest/*_latest.json
!independent_reviews/latest/independent_review_*_manual.md
!independent_reviews/latest/independent_review_*_manual.json
!independent_reviews/latest/independent_review_*_pre-commit.md
!independent_reviews/latest/independent_review_*_pre-commit.json
!independent_reviews/latest/independent_review_*_pre-merge-commit.md
!independent_reviews/latest/independent_review_*_pre-merge-commit.json
!independent_reviews/latest/independent_review_*_pre-push.md
!independent_reviews/latest/independent_review_*_pre-push.json
!independent_reviews/latest/kpi_trend_scoreboard_backfill.md
!independent_reviews/latest/kpi_trend_scoreboard_backfill.json
!independent_reviews/latest/independent_review_backfill_over_time.md

# High-churn local ledgers regenerated by hooks (kept local)
independent_reviews/latest/governance_execution_ledger_latest.md
independent_reviews/latest/governance_execution_ledger_latest.json
independent_reviews/latest/architecture_design_authoring_workpack_latest.md
independent_reviews/latest/architecture_design_authoring_workpack_latest.json
independent_reviews/latest/kpi_drift_analysis_latest.md
independent_reviews/latest/kpi_drift_analysis_latest.json

# Local secrets and environment overrides
.env
.env.*
*.pem
*.key

# Data infrastructure (RAG / Vector DB)
# Track: READMEs and configs; Ignore: indexes, outputs, fetched data
data/vector_db/indexes/
data/vector_db/*.faiss
data/vector_db/*.pkl
data/outputs/
data/inputs/fetched/
!data/README.md
!data/vector_db/README.md
!data/vector_db/config.yaml
!data/inputs/README.md
!data/models/README.md
!data/models/embeddings.yaml
!data/outputs/README.md
