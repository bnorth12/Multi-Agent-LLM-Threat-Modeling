# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging
dist/
build/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checker and linter caches
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter and local runtime artifacts
.ipynb_checkpoints/
.tmp/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/settings.json


# Logs and test outputs
*.log
*.txt
test_reports/*
!test_reports/README.md
# Independent review artifacts:
# - Track ONLY the single canonical pair in independent_reviews/latest/
#   (independent_review_<sprint>_<context>.md + .json). This pair is the live
#   independent review and is the KNOWN EXCEPTION that will always dirty the tree
#   after pre-push/push (governance autoflow intentionally regenerates it; we know why).
# - Retention + is_allowed_generated_review_change enforce the single-file rule.
# - Everything else under independent_reviews/ (history, old sidecars, batches) is ignored.
independent_reviews/**
!independent_reviews/README.md
!independent_reviews/latest/
!independent_reviews/latest/independent_review_*.md
!independent_reviews/latest/independent_review_*.json
!independent_reviews/history/
!independent_reviews/history/reports/
!independent_reviews/history/reports/auto_compaction_*/
independent_reviews/history/reports/auto_compaction_*/**
!independent_reviews/history/reports/auto_compaction_*/manifest.md
!independent_reviews/history/reports/auto_compaction_*/manifest.json
!independent_reviews/history/reports/auto_compaction_*/ier_mitigation_snapshot.json
!independent_reviews/history/reports/auto_compaction_rollup_summary.md
!independent_reviews/history/reports/auto_compaction_rollup_summary.json

# Local secrets and environment overrides
.env
.env.*
*.pem
*.key

# Data infrastructure (RAG / Vector DB)
# Track: READMEs and configs; Ignore: indexes, outputs, fetched data
data/vector_db/indexes/
data/vector_db/*.faiss
data/vector_db/*.pkl
data/outputs/
data/inputs/fetched/
!data/README.md
!data/vector_db/README.md
!data/vector_db/config.yaml
!data/inputs/README.md
!data/models/README.md
!data/models/embeddings.yaml
!data/outputs/README.md
