#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

SPRINT_DEFAULTS_FILE="$ROOT_DIR/config/sprint_defaults.env"
if [ -f "$SPRINT_DEFAULTS_FILE" ]; then
  # shellcheck disable=SC1090
  . "$SPRINT_DEFAULTS_FILE"
fi
DEFAULT_SPRINT="${DEFAULT_SPRINT:-2026_013}"

echo "[pre-push] Running local quality gates before push..."

if [ -x "$ROOT_DIR/.venv/Scripts/python.exe" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/Scripts/python.exe"
elif [ -x "$ROOT_DIR/.venv/bin/python" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "[pre-push] ERROR: Python is required but was not found on PATH."
  exit 1
fi

path_sep=":"
if uname | grep -Eiq "mingw|msys|cygwin"; then
  path_sep=";"
fi
if [ -d "$ROOT_DIR/src" ]; then
  export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+$path_sep$PYTHONPATH}"
fi

if [ -f "scripts/set_test_env.ps1" ]; then
  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/set_test_env.ps1 >/dev/null
  elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set_test_env.ps1 >/dev/null
  fi
fi

echo "[pre-push] Running unit tests (Tests/unit)..."
"$PYTHON_BIN" -m pytest Tests/unit/ -q

echo "[pre-push] Running sprint traceability verification..."
TRACEABILITY_SPRINT="${TRACEABILITY_SPRINT:-$DEFAULT_SPRINT}"
if ! "$PYTHON_BIN" scripts/verify_sprint_traceability.py --sprint "$TRACEABILITY_SPRINT"; then
  if [ "${TRACEABILITY_ENFORCE:-0}" = "1" ]; then
    echo "[pre-push] ERROR: Traceability check failed and TRACEABILITY_ENFORCE=1."
    exit 1
  fi
  echo "[pre-push] WARNING: Traceability check failed for sprint '$TRACEABILITY_SPRINT'."
  echo "[pre-push] Continuing push (set TRACEABILITY_ENFORCE=1 to make this blocking)."
fi

echo "[pre-push] Running archive hygiene checks against upstream diff..."
if ! "$PYTHON_BIN" scripts/archive_hygiene.py check --upstream --enforce; then
  if [ "${ARCHIVE_HYGIENE_ENFORCE:-1}" = "1" ]; then
    echo "[pre-push] ERROR: Archive hygiene check failed and ARCHIVE_HYGIENE_ENFORCE=1."
    exit 1
  fi
  echo "[pre-push] WARNING: Archive hygiene check failed."
  echo "[pre-push] Continuing push (set ARCHIVE_HYGIENE_ENFORCE=1 to make this blocking)."
fi

echo "[pre-push] Running cross-domain exception policy validation..."
if ! "$PYTHON_BIN" scripts/validate_cross_domain_exception_policy.py; then
  if [ "${EXCEPTION_POLICY_ENFORCE:-1}" = "1" ]; then
    echo "[pre-push] ERROR: Exception policy validation failed and EXCEPTION_POLICY_ENFORCE=1."
    exit 1
  fi
  echo "[pre-push] WARNING: Exception policy validation failed."
  echo "[pre-push] Continuing push (set EXCEPTION_POLICY_ENFORCE=1 to make this blocking)."
fi

echo "[pre-push] Running governance autoflow..."
INDEPENDENT_REVIEW_SPRINT="${INDEPENDENT_REVIEW_SPRINT:-$DEFAULT_SPRINT}"
INDEPENDENT_REVIEW_HOOK_FAIL_MODE="${INDEPENDENT_REVIEW_HOOK_FAIL_MODE:-warn}"
if ! "$PYTHON_BIN" scripts/governance_autoflow.py \
  --context pre-push \
  --sprint "$INDEPENDENT_REVIEW_SPRINT" \
  --hook-fail-mode "$INDEPENDENT_REVIEW_HOOK_FAIL_MODE"; then
  if [ "$INDEPENDENT_REVIEW_HOOK_FAIL_MODE" != "warn" ]; then
    echo "[pre-push] ERROR: Governance autoflow blocking conditions were met."
    exit 1
  fi
  echo "[pre-push] WARNING: Governance autoflow reported execution failure."
  echo "[pre-push] Continuing push because INDEPENDENT_REVIEW_HOOK_FAIL_MODE=warn."
fi

echo "[pre-push] Generating exception-policy remediation proposals..."
"$PYTHON_BIN" scripts/validate_cross_domain_exception_policy.py \
  --proposal-only \
  --propose-missing \
  --proposal-out test_reports/cross_domain_exception_proposals.csv >/dev/null || true

echo "[pre-push] All checks passed. Proceeding with push."
