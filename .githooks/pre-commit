#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "[pre-commit] Checking archive hygiene on staged changes..."

if [ -x "$ROOT_DIR/.venv/Scripts/python.exe" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/Scripts/python.exe"
elif [ -x "$ROOT_DIR/.venv/bin/python" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "[pre-commit] ERROR: Python is required but was not found on PATH."
  exit 1
fi

"$PYTHON_BIN" scripts/archive_hygiene.py check --staged --enforce

echo "[pre-commit] Running independent local review (profile-based enforcement)..."
INDEPENDENT_REVIEW_SPRINT="${INDEPENDENT_REVIEW_SPRINT:-2026_12}"
# Profile routing is defined in scripts/resolve_independent_review_profile.sh.
# Update that helper if branch/env precedence changes.
IFS=$'\t' read -r EFFECTIVE_INDEPENDENT_REVIEW_PROFILE PROFILE_SOURCE CURRENT_BRANCH < <(bash scripts/resolve_independent_review_profile.sh)
INDEPENDENT_REVIEW_HOOK_FAIL_MODE="${INDEPENDENT_REVIEW_HOOK_FAIL_MODE:-profile}"
echo "[pre-commit] Independent review profile: $EFFECTIVE_INDEPENDENT_REVIEW_PROFILE (source: $PROFILE_SOURCE, branch: ${CURRENT_BRANCH:-detached})"
if ! "$PYTHON_BIN" scripts/independent_repo_review.py \
  --sprint "$INDEPENDENT_REVIEW_SPRINT" \
  --run-context pre-commit \
  --report-mode update \
  --policy-profile "$EFFECTIVE_INDEPENDENT_REVIEW_PROFILE" \
  --enforcement-mode auto \
  --out-dir local_reviews/latest; then
  if [ "$INDEPENDENT_REVIEW_HOOK_FAIL_MODE" != "warn" ]; then
    echo "[pre-commit] ERROR: Independent review blocking conditions met for profile '$EFFECTIVE_INDEPENDENT_REVIEW_PROFILE'."
    exit 1
  fi
  echo "[pre-commit] WARNING: Independent review reported execution failure."
  echo "[pre-commit] Continuing commit because INDEPENDENT_REVIEW_HOOK_FAIL_MODE=warn."
fi

echo "[pre-commit] Archive hygiene check passed."
