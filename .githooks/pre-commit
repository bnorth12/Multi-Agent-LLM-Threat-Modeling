#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

SPRINT_DEFAULTS_FILE="$ROOT_DIR/config/sprint_defaults.env"
if [ -f "$SPRINT_DEFAULTS_FILE" ]; then
  # shellcheck disable=SC1090
  . "$SPRINT_DEFAULTS_FILE"
fi
DEFAULT_SPRINT="${DEFAULT_SPRINT:-2026_013}"

echo "[pre-commit] Checking archive hygiene on staged changes..."

if [ -x "$ROOT_DIR/.venv/Scripts/python.exe" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/Scripts/python.exe"
elif [ -x "$ROOT_DIR/.venv/bin/python" ]; then
  PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "[pre-commit] ERROR: Python is required but was not found on PATH."
  exit 1
fi

"$PYTHON_BIN" scripts/archive_hygiene.py check --staged --enforce

echo "[pre-commit] Running governance autoflow..."
INDEPENDENT_REVIEW_SPRINT="${INDEPENDENT_REVIEW_SPRINT:-$DEFAULT_SPRINT}"
INDEPENDENT_REVIEW_HOOK_FAIL_MODE="${INDEPENDENT_REVIEW_HOOK_FAIL_MODE:-warn}"
if ! "$PYTHON_BIN" scripts/governance_autoflow.py \
  --context pre-commit \
  --sprint "$INDEPENDENT_REVIEW_SPRINT" \
  --hook-fail-mode "$INDEPENDENT_REVIEW_HOOK_FAIL_MODE"; then
  if [ "$INDEPENDENT_REVIEW_HOOK_FAIL_MODE" != "warn" ]; then
    echo "[pre-commit] ERROR: Governance autoflow blocking conditions were met."
    exit 1
  fi
  echo "[pre-commit] WARNING: Governance autoflow reported execution failure."
  echo "[pre-commit] Continuing commit because INDEPENDENT_REVIEW_HOOK_FAIL_MODE=warn."
fi

echo "[pre-commit] Archive hygiene check passed."
